# Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/google/callback

# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=cole-aqui-um-segredo-hexadecimal-de-64-caracteres
SESSION_FILE=

# Anthropic (Claude API)
ANTHROPIC_API_KEY=

# OpenAI (Whisper - transcrição de áudio)
OPENAI_API_KEY=

# Banco de dados
DB_PATH=
# Obrigatório em produção: diretório do volume persistente (ex.: /data)
PERSISTENCE_DIR=
PRIVACY_POLICY_VERSION=2026-08-18
AUDIT_RETENTION_DAYS=365

# App
API_PORT=3001
WEB_URL=http://localhost:3000
API_URL=http://localhost:3001

# Expo (valor público incorporado no aplicativo; nunca coloque segredos aqui)
EXPO_PUBLIC_API_URL=http://localhost:3001
