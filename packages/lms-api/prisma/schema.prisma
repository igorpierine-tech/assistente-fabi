generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("LMS_DATABASE_URL")
}

// ─── RBAC ────────────────────────────────────────────────────────────────────

enum Role {
  OWNER
  ADMIN
  MENTOR
  STUDENT
}

// ─── TENANT (SaaS multi-tenancy) ────────────────────────────────────────────

enum PlanTier {
  FREE
  STARTER
  PRO
  ENTERPRISE
}

model Tenant {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug          String   @unique @db.VarChar(100)
  name          String   @db.VarChar(200)
  logoUrl       String?  @map("logo_url") @db.VarChar(500)
  primaryColor  String?  @map("primary_color") @db.VarChar(7)
  accentColor   String?  @map("accent_color") @db.VarChar(7)
  customDomain  String?  @unique @map("custom_domain") @db.VarChar(253)
  plan          PlanTier @default(FREE)
  maxStudents   Int      @default(10) @map("max_students")
  maxPrograms   Int      @default(1) @map("max_programs")
  maxStorageMb  Int      @default(500) @map("max_storage_mb")
  hotmartSubscriptionCode String? @unique @map("hotmart_subscription_code") @db.VarChar(255)
  active        Boolean  @default(true)
  trialEndsAt   DateTime? @map("trial_ends_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  users              User[]
  programs           Program[]
  badges             Badge[]
  auditLogs          AuditLog[]
  plans              Plan[]
  gamificationRules  GamificationRule[]

  @@index([slug])
  @@index([customDomain])
  @@map("tenants")
}

// ─── CONTENT PLANS & SUBSCRIPTIONS ──────────────────────────────────────────

enum PlanPeriodicity {
  MONTHLY
  QUARTERLY
  SEMIANNUAL
  ANNUAL
  LIFETIME
}

enum SubscriptionStatus {
  ACTIVE
  CANCELED
  EXPIRED
  PAST_DUE
}

model Plan {
  id           String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId     String          @map("tenant_id") @db.Uuid
  slug         String          @db.VarChar(100)
  name         String          @db.VarChar(200)
  description  String?         @db.Text
  periodicity  PlanPeriodicity @default(ANNUAL)
  priceInCents Int?            @map("price_in_cents")
  active       Boolean         @default(true)
  sortOrder    Int             @default(0) @map("sort_order")
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")

  tenant        Tenant         @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  contents      PlanContent[]
  subscriptions Subscription[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([active])
  @@map("plans")
}

model PlanContent {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  planId    String   @map("plan_id") @db.Uuid
  programId String?  @map("program_id") @db.Uuid
  moduleId  String?  @map("module_id") @db.Uuid
  lessonId  String?  @map("lesson_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at")

  plan    Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  program Program? @relation(fields: [programId], references: [id], onDelete: Cascade)
  module  Module?  @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  lesson  Lesson?  @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@index([programId])
  @@index([moduleId])
  @@index([lessonId])
  @@map("plan_contents")
}

model Subscription {
  id         String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String             @map("user_id") @db.Uuid
  planId     String             @map("plan_id") @db.Uuid
  status     SubscriptionStatus @default(ACTIVE)
  startsAt   DateTime           @default(now()) @map("starts_at")
  expiresAt  DateTime?          @map("expires_at")
  canceledAt DateTime?          @map("canceled_at")
  externalId String?            @map("external_id") @db.VarChar(255)
  createdAt  DateTime           @default(now()) @map("created_at")
  updatedAt  DateTime           @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([planId])
  @@index([status])
  @@index([expiresAt])
  @@map("subscriptions")
}

// ─── USERS & AUTH ────────────────────────────────────────────────────────────

model User {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId       String    @map("tenant_id") @db.Uuid
  email          String    @db.VarChar(255)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  role           Role      @default(STUDENT)
  emailVerified  Boolean   @default(false) @map("email_verified")
  emailVerifyToken String? @map("email_verify_token") @db.VarChar(255)
  passwordResetToken String? @map("password_reset_token") @db.VarChar(255)
  passwordResetExpires DateTime? @map("password_reset_expires")
  failedLoginAttempts Int   @default(0) @map("failed_login_attempts")
  lockedUntil    DateTime? @map("locked_until")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  tenant         Tenant    @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  profile        Profile?
  sessions       Session[]
  auditLogs      AuditLog[]
  enrollments        Enrollment[]
  subscriptions      Subscription[]
  submissions        Submission[]
  pointLedger        PointLedger[]
  badges             UserBadge[]
  lessonProgress     LessonProgress[]
  gamificationProfile GamificationProfile?

  @@unique([tenantId, email])
  @@index([email])
  @@index([tenantId])
  @@index([passwordResetToken])
  @@map("users")
}

model Profile {
  id        String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String  @unique @map("user_id") @db.Uuid
  firstName String  @map("first_name") @db.VarChar(100)
  lastName  String  @map("last_name") @db.VarChar(100)
  avatarUrl String? @map("avatar_url") @db.VarChar(500)
  phone     String? @db.VarChar(30)
  company   String? @db.VarChar(200)
  jobTitle  String? @map("job_title") @db.VarChar(200)
  bio       String? @db.Text
  lgpdConsentAt    DateTime? @map("lgpd_consent_at")
  lgpdConsentVersion String? @map("lgpd_consent_version") @db.VarChar(20)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Session {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String   @map("user_id") @db.Uuid
  refreshToken String   @unique @map("refresh_token") @db.VarChar(500)
  userAgent    String?  @map("user_agent") @db.VarChar(500)
  ipAddress    String?  @map("ip_address") @db.VarChar(45)
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([refreshToken])
  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AuditLog {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId  String?  @map("tenant_id") @db.Uuid
  userId    String?  @map("user_id") @db.Uuid
  action    String   @db.VarChar(100)
  entity    String?  @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  metadata  Json?
  ipAddress String?  @map("ip_address") @db.VarChar(45)
  userAgent String?  @map("user_agent") @db.VarChar(500)
  createdAt DateTime @default(now()) @map("created_at")

  tenant Tenant? @relation(fields: [tenantId], references: [id], onDelete: SetNull)
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([tenantId])
  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─── PROGRAMS & CONTENT ──────────────────────────────────────────────────────

model Program {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String   @map("tenant_id") @db.Uuid
  slug        String   @db.VarChar(100)
  title       String   @db.VarChar(200)
  subtitle    String?  @db.VarChar(300)
  description String?  @db.Text
  coverUrl    String?  @map("cover_url") @db.VarChar(500)
  published   Boolean  @default(false)
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  tenant       Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  modules      Module[]
  enrollments  Enrollment[]
  planContents PlanContent[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@index([published])
  @@map("programs")
}

model Module {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId   String   @map("program_id") @db.Uuid
  slug        String   @db.VarChar(100)
  title       String   @db.VarChar(200)
  description String?  @db.Text
  sortOrder   Int      @default(0) @map("sort_order")
  published   Boolean  @default(false)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  program      Program       @relation(fields: [programId], references: [id], onDelete: Cascade)
  lessons      Lesson[]
  planContents PlanContent[]

  @@unique([programId, slug])
  @@index([programId, sortOrder])
  @@map("modules")
}

enum LessonType {
  VIDEO
  LIVE
  TEXT
  ASSESSMENT
}

model Lesson {
  id           String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  moduleId     String     @map("module_id") @db.Uuid
  slug         String     @db.VarChar(100)
  title        String     @db.VarChar(200)
  description  String?    @db.Text
  type         LessonType @default(VIDEO)
  videoUrl     String?    @map("video_url") @db.VarChar(500)
  videoDuration Int?      @map("video_duration")
  liveUrl      String?    @map("live_url") @db.VarChar(500)
  liveStartsAt DateTime?  @map("live_starts_at")
  content      String?    @db.Text
  xpReward     Int        @default(10) @map("xp_reward")
  sortOrder    Int        @default(0) @map("sort_order")
  published    Boolean    @default(false)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  module       Module           @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  materials    Material[]
  progress     LessonProgress[]
  assessments  Assessment[]
  planContents PlanContent[]

  @@unique([moduleId, slug])
  @@index([moduleId, sortOrder])
  @@map("lessons")
}

model Material {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId  String   @map("lesson_id") @db.Uuid
  title     String   @db.VarChar(200)
  fileUrl   String   @map("file_url") @db.VarChar(500)
  fileType  String   @map("file_type") @db.VarChar(50)
  fileSize  Int?     @map("file_size")
  sortOrder Int      @default(0) @map("sort_order")
  createdAt DateTime @default(now()) @map("created_at")

  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
  @@map("materials")
}

// ─── ENROLLMENTS & PROGRESS ──────────────────────────────────────────────────

model Enrollment {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  programId  String   @map("program_id") @db.Uuid
  enrolledAt DateTime @default(now()) @map("enrolled_at")
  completedAt DateTime? @map("completed_at")

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  program Program @relation(fields: [programId], references: [id], onDelete: Cascade)

  @@unique([userId, programId])
  @@index([userId])
  @@index([programId])
  @@map("enrollments")
}

model LessonProgress {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  lessonId    String    @map("lesson_id") @db.Uuid
  completed   Boolean   @default(false)
  completedAt DateTime? @map("completed_at")
  watchTime   Int       @default(0) @map("watch_time")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  lesson Lesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@unique([userId, lessonId])
  @@index([userId])
  @@index([lessonId])
  @@map("lesson_progress")
}

// ─── ASSESSMENTS ─────────────────────────────────────────────────────────────

enum AssessmentType {
  QUIZ
  DIAGNOSTIC
  ACTION_PLAN
  SELF_EVALUATION
}

model Assessment {
  id          String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  lessonId    String         @map("lesson_id") @db.Uuid
  title       String         @db.VarChar(200)
  type        AssessmentType @default(QUIZ)
  description String?        @db.Text
  questions   Json?
  xpReward    Int            @default(20) @map("xp_reward")
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")

  lesson      Lesson       @relation(fields: [lessonId], references: [id], onDelete: Cascade)
  submissions Submission[]

  @@index([lessonId])
  @@map("assessments")
}

model Submission {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  assessmentId String    @map("assessment_id") @db.Uuid
  answers      Json?
  fileUrl      String?   @map("file_url") @db.VarChar(500)
  score        Int?
  feedback     String?   @db.Text
  submittedAt  DateTime  @default(now()) @map("submitted_at")
  reviewedAt   DateTime? @map("reviewed_at")

  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  assessment Assessment @relation(fields: [assessmentId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([assessmentId])
  @@map("submissions")
}

// ─── GAMIFICATION ────────────────────────────────────────────────────────────

enum GamificationEvent {
  LESSON_COMPLETED
  LIVE_SESSION_ATTENDED
  ASSESSMENT_SUBMITTED
  STREAK_MILESTONE
  PROGRAM_COMPLETED
  MODULE_COMPLETED
  ENROLLMENT_CREATED
}

enum BadgeCategory {
  STRATEGY
  CONSISTENCY
  GOVERNANCE
  LEADERSHIP
  MILESTONE
}

enum LeadershipTier {
  GESTORA_AUREA
  LIDER_ESTRATEGICA
  EXECUTIVA_ALTO_IMPACTO
}

model GamificationRule {
  id          String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String            @map("tenant_id") @db.Uuid
  event       GamificationEvent
  name        String            @db.VarChar(200)
  description String?           @db.Text
  xpReward    Int               @map("xp_reward")
  badgeId     String?           @map("badge_id") @db.Uuid
  conditions  Json?
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  tenant        Tenant        @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  badge         Badge?        @relation(fields: [badgeId], references: [id], onDelete: SetNull)
  ledgerEntries PointLedger[]

  @@index([tenantId])
  @@index([event])
  @@map("gamification_rules")
}

model GamificationProfile {
  id             String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId         String         @unique @map("user_id") @db.Uuid
  totalXp        Int            @default(0) @map("total_xp")
  currentTier    LeadershipTier @default(GESTORA_AUREA) @map("current_tier")
  currentStreak  Int            @default(0) @map("current_streak")
  longestStreak  Int            @default(0) @map("longest_streak")
  lastActivityAt DateTime?      @map("last_activity_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("gamification_profiles")
}

model Badge {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tenantId    String        @map("tenant_id") @db.Uuid
  slug        String        @db.VarChar(100)
  title       String        @db.VarChar(200)
  description String?       @db.Text
  iconUrl     String?       @map("icon_url") @db.VarChar(500)
  category    BadgeCategory @default(MILESTONE)
  xpReward    Int           @default(0) @map("xp_reward")
  criteria    Json?
  createdAt   DateTime      @default(now()) @map("created_at")

  tenant            Tenant             @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  users             UserBadge[]
  gamificationRules GamificationRule[]

  @@unique([tenantId, slug])
  @@index([tenantId])
  @@map("badges")
}

model UserBadge {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId   String   @map("user_id") @db.Uuid
  badgeId  String   @map("badge_id") @db.Uuid
  earnedAt DateTime @default(now()) @map("earned_at")

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id], onDelete: Cascade)

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model PointLedger {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        String   @map("user_id") @db.Uuid
  ruleId        String?  @map("rule_id") @db.Uuid
  points        Int
  reason        String   @db.VarChar(200)
  referenceType String?  @map("reference_type") @db.VarChar(50)
  referenceId   String?  @map("reference_id") @db.Uuid
  createdAt     DateTime @default(now()) @map("created_at")

  user User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  rule GamificationRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@unique([userId, ruleId, referenceId])
  @@index([userId])
  @@index([createdAt])
  @@map("point_ledger")
}
