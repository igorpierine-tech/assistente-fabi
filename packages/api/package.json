{
  "name": "@assistente-fabi/api",
  "version": "1.0.0",
  "private": true,
  "main": "./src/index.ts",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/server.js --format=cjs --sourcemap --external:better-sqlite3 --external:cors --external:dotenv --external:express --external:express-session --external:google-auth-library --external:googleapis --external:luxon --external:multer --external:openai --external:uuid",
    "start": "node dist/server.js",
    "lint": "tsc --noEmit",
    "test": "tsx --test src/services/validation.test.ts src/services/mobile-auth.test.ts"
  },
  "dependencies": {
    "@assistente-fabi/ai": "workspace:*",
    "@assistente-fabi/shared": "workspace:*",
    "better-sqlite3": "^13.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^4.21.0",
    "express-session": "^1.18.1",
    "google-auth-library": "^9.15.1",
    "googleapis": "^148.0.0",
    "luxon": "^3.6.1",
    "multer": "^1.4.5-lts.1",
    "openai": "^4.85.0",
    "tsx": "^4.19.0",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/express-session": "^1.18.1",
    "@types/luxon": "^3.4.2",
    "@types/multer": "^1.4.12",
    "@types/uuid": "^10.0.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.8.0"
  }
}
